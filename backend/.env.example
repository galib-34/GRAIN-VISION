# Application environment: 'development' or 'production'
# In production mode, wildcard CORS (*) is strictly disallowed!
ENVIRONMENT=development

# CORS: Comma-separated list of allowed origins.
# In development, leave blank or * to allow local testing.
# In production, set to your exact hosted frontend origin (e.g., https://grainvision.example.com)
CORS_ORIGINS=*

# Server execution binding
HOST=0.0.0.0
PORT=8000
WORKERS=2

# SSL / HTTPS certificates (optional, for direct TLS termination)
# SSL_CERTFILE=/path/to/fullchain.pem
# SSL_KEYFILE=/path/to/privkey.pem

# YOLOv8n model weights (defaults to models/train2.pt)
# YOLO_MODEL_PATH=models/train2.pt
YOLO_CONFIDENCE=0.25
MAX_IMAGE_BYTES=20971520

# Procurement priority order approved by management
GRAIN_CLASS_PRIORITY=sound,whole-chalky,broken-clear,broken-chalky,unsound,foreign-object,stone,plastic

# Official AGMARKNET daily mandi data via data.gov.in
# If API returns HTTP 403 or network error, detailed diagnostic stack traces are logged
# and the engine falls back gracefully to cached prices or local baseline.
OGD_API_KEY=
OGD_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
OGD_MANDI_COMMODITY=Paddy

# Background mandi price cache duration (hours)
MANDI_CACHE_TTL_HOURS=12

# Local base reference price per quintal (fallback when offline or API is down)
BASE_REFERENCE_PRICE_PER_QUINTAL=2300.0

# Optional manually maintained reference fallback
AP_MANUAL_REFERENCE_PRICE_PER_QUINTAL=
AP_MANUAL_REFERENCE_DATE=
AP_MANUAL_REFERENCE_SOURCE=

# Optional approved per-class rate schedule (JSON mapping INR/kg)
# CLASS_PRICE_INR_PER_KG={"sound": 28.5, "whole-chalky": 24.0, "broken-clear": 21.0, "broken-chalky": 18.0, "unsound": 12.0, "foreign-object": 0.0, "stone": 0.0, "plastic": 0.0}
